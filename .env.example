# Образец настроек. НЕ клади сюда настоящие значения и не коммить файл .env.
# В Yandex Cloud всё это задаётся в переменных ревизии контейнера (через GitHub Secrets, см. docs/yandex_cloud.md).

# Пароль для входа в приложение (потом можно сменить в Настройках — тогда он хранится хэшем в базе)
KVIZY_PASSWORD=
# Секрет подписи cookie (длинная случайная строка)
SESSION_SECRET=
# Секрет шифрования ключей ИИ в базе (длинная случайная строка, НЕ меняй после сохранения ключей)
KEY_SECRET=

# Какой ИИ по умолчанию: yandex | gigachat | claude | openai | mock (меняется и в Настройках приложения)
AI_PROVIDER=yandex

# YandexGPT (ключ лучше вписать в Настройках приложения — он сохранится зашифрованным)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite/latest

# GigaChat
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Любой OpenAI-совместимый сервис
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# База. Пусто = локальный файл SQLite (data/kvizy.db).
# Для YDB — адрес из консоли: grpcs://ydb.serverless.yandexcloud.net:2135/?database=/ru-central1/.../...
DATABASE_URL=

# Бюджет в месяц, ₽ (только для показа)
MONTHLY_BUDGET_RUB=500
